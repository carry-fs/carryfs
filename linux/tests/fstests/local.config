# fstests configuration for the CarryFS kernel driver; run.sh sets the
# devices and paths.
export FSTYP=carryfs
export TEST_DEV=${TEST_DEV:?}
export TEST_DIR=${TEST_DIR:?}
export SCRATCH_DEV=${SCRATCH_DEV:?}
export SCRATCH_MNT=${SCRATCH_MNT:?}
# CarryFS needs at least 256 MiB; tests that size their own devices,
# such as generic/563, honor this.
export MIN_FSSIZE=268435456
